# =============================================================================
# docling-llamaindex-pipeline — environment contract
# Copy to `.env` (gitignored) and adjust. Every variable is optional; the
# commented value is the default from src/docling_llamaindex_pipeline/config.py.
# NEVER commit real credentials — secret-bearing variables are left empty.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# development | staging | production  (production enforces explicit CORS
# origins and a non-empty ADMIN_API_KEY at startup)
APP_ENV=development
LOG_LEVEL=INFO
# Bind address for `uv run docling-llamaindex-pipeline` / `mise run serve`.
# Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=8000

# ---- Provider selection -----------------------------------------------------
# Embeddings at boot: ollama | ibm | openai  (hot-swappable via
# POST /api/v1/config/embedding)
EMBEDDING_PROVIDER=ollama
# Answer synthesis: ollama | openai | anthropic
LLM_PROVIDER=ollama

# ---- Ollama (local / air-gapped default) -----------------------------------
# IBM Granite models only; models developed in China are not used
# (tests/unit/test_model_policy.py). `ollama pull` both before starting.
# Base URL without /v1.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=granite4.2:latest
# Multilingual (incl. Japanese), 768 dims, 512-token context.
OLLAMA_EMBED_MODEL=granite-embedding:278m
# OLLAMA_REQUEST_TIMEOUT=120
# num_ctx for the chat model; unset would default to the model max (131072).
# OLLAMA_CONTEXT_WINDOW=8192

# ---- IBM watsonx.ai (needs `uv sync --extra ibm`) ---------------------------
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_EMBED_MODEL=ibm/slate-125m-english-rtrvr-v2

# ---- OpenAI (needs `uv sync --extra openai`) --------------------------------
OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_LLM_MODEL=gpt-4o-mini

# ---- Anthropic (LLM only; needs `uv sync --extra anthropic`) ------------------
# Anthropic has no embeddings API: keep EMBEDDING_PROVIDER on ollama or openai.
ANTHROPIC_API_KEY=
# ANTHROPIC_LLM_MODEL=claude-opus-5-5

# ---- Ingestion ----------------------------------------------------------------
# Uploads are staged in a private per-request sub-directory and deleted after
# parsing.
# TEMP_UPLOAD_DIR=./data_uploads
# MAX_UPLOAD_SIZE_MB=50
# Docling conversions allowed at once (layout / TableFormer models are memory-hungry).
# MAX_CONCURRENT_INGESTIONS=1
# QUERY_TIMEOUT_SECONDS=120

# ---- Docling (PDF pipeline) -----------------------------------------------
# DOCLING_DO_OCR=true
# OCR engine is pinned (Docling's auto mode may select PaddleOCR-derived models):
#   tesseract  needs the `tesseract` binary + language packs (default)
#   easyocr    needs the `easyocr` package
# DOCLING_OCR_ENGINE=tesseract
# DOCLING_OCR_LANG=["iso:jpn","iso:eng"]
# DOCLING_DO_TABLE_STRUCTURE=true
# auto | cpu | cuda | mps | xpu
# DOCLING_DEVICE=auto
# Pre-downloaded models for air-gapped hosts (`docling-tools models download`).
# DOCLING_ARTIFACTS_PATH=

# ---- Chunking ----------------------------------------------------------------
# hybrid: token-bounded chunks sized for the embedding model (tokenizer fetched
#         from the Hugging Face Hub once, then cached; HF_HUB_OFFLINE=1 after)
# hierarchical: one chunk per document element, no token limit, no download
# CHUNKER=hybrid
# CHUNK_TOKENIZER=ibm-granite/granite-embedding-278m-multilingual
# CHUNK_MAX_TOKENS=512

# ---- HTTP security ---------------------------------------------------------
# JSON list. Empty = CORS disabled. "*" is rejected when APP_ENV=production.
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_ORIGINS=[]
# When set, POST /api/v1/config/embedding requires `X-Admin-Token: <value>`.
ADMIN_API_KEY=

# ---- Test lanes --------------------------------------------------------------
# 1 = run the live Ollama suite (`mise run test:integration`).
RUN_INTEGRATION_OLLAMA=0
